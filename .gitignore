# Dependencies. No trailing slash: a worktree may symlink node_modules to the
# primary clone's, and `node_modules/` matches only directories — a symlink
# slipped past it once in rpslr and got committed.
# The client still builds with Vite, so Node is still here; the api is Python.
node_modules
**/node_modules

# Python
__pycache__/
*.py[cod]
.venv/
**/.venv/
*.egg-info/
**/*.egg-info/
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/

# Build output
dist/
build/
**/dist/
**/build/

# TypeScript incremental build info
*.tsbuildinfo

# Env files (never commit real secrets)
.env
.env.local
.env.*.local
!.env.example

# Logs
*.log
npm-debug.log*
.dev-pids

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Test / coverage
coverage/
**/coverage/
test-results/

# Agent worktrees (one per task; never committed)
.claude/worktrees/

# Real k8s secrets. Only the *.example.yaml templates are committed, and
# environment-config-test.yml fails the build if that ever stops being true.
k8s/secrets/*.yaml
!k8s/secrets/*.example.yaml

# The stub Lobby's cached RS256 signing key (scripts/stub-lobby.sh).
.stub-lobby/
