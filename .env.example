# ============================================================================
# Go Forth! — JoinQuest game
# Copy to .env and adjust as needed:  cp .env.example .env
# ============================================================================
# This game runs INDEPENDENTLY from the JoinQuest Lobby platform and from the
# other demo game (rpslr). It has its own ports and its own database so all
# three can run on one machine at the same time.
#
# Port plan (do NOT collide with Lobby or rpslr):
#   | Service   | Go Forth! | rpslr | Lobby |
#   |-----------|-----------|-------|-------|
#   | Client    | 5175      | 5174  | 5173  |
#   | API       | 3002      | 3001  | 8080  |
#   | Postgres  | 5434      | 5433  | 5432  |
# ============================================================================

# ---- Environment ------------------------------------------------------------
GAME_APP_ENV=local           # local | staging | production

# ---- Game API (api/) --------------------------------------------------------
API_PORT=3002
# CORS: comma-separated list of allowed origins (Lobby dev origins included).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175

# ---- Game client (client/) --------------------------------------------------
GAME_API_BASE_URL=http://localhost:3002
# Browser play URL the Lobby uses for launch links (must match catalog playUrl).
GAME_PLAY_URL=http://localhost:5175

# ---- Game database ----------------------------------------------------------
# Reserved here so the port plan lives in one place. Nothing reads these yet:
# Postgres, migrations, and docker-compose arrive with the runtime ticket
# (JQ-285). 5434 avoids rpslr's 5433 and the Lobby's 5432.
POSTGRES_PORT=5434
POSTGRES_HOST=localhost
POSTGRES_USER=goforth
POSTGRES_PASSWORD=goforth_dev_password
POSTGRES_DB=go_forth
