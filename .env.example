# ============================================================================
# Go Forth! — JoinQuest game
# Copy to .env and adjust as needed:  cp .env.example .env
# ============================================================================
# This game runs INDEPENDENTLY from the JoinQuest Lobby platform and from the
# other demo game (rpslr). It has its own ports and its own database so all
# three can run on one machine at the same time.
#
# Port plan (do NOT collide with Lobby or rpslr):
#   | Service   | Go Forth! | rpslr | Lobby |
#   |-----------|-----------|-------|-------|
#   | Client    | 5175      | 5174  | 5173  |
#   | API       | 3002      | 3001  | 8080  |
#   | Postgres  | 5434      | 5433  | 5432  |
# ============================================================================

# ---- Environment ------------------------------------------------------------
GAME_APP_ENV=local           # local | staging | production

# ---- Game API (api/) --------------------------------------------------------
API_PORT=3002
# CORS: comma-separated list of allowed origins (Lobby dev origins included).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175

# ---- Game client (client/) --------------------------------------------------
GAME_API_BASE_URL=http://localhost:3002
# Browser play URL the Lobby uses for launch links (must match catalog playUrl).
GAME_PLAY_URL=http://localhost:5175

# ---- Game database ----------------------------------------------------------
# Host port for this game's Postgres. 5434 avoids rpslr's 5433 and the Lobby's
# 5432; if something else already holds it (an SSH tunnel, say), change it here
# and docker-compose, the scripts, and the derived DSN all follow.
POSTGRES_PORT=5434
POSTGRES_HOST=localhost
POSTGRES_USER=goforth
POSTGRES_PASSWORD=goforth_dev_password
POSTGRES_DB=go_forth
# DATABASE_URL is derived from the POSTGRES_* values above, so POSTGRES_PORT
# stays the one place the port is written down. Set it only to point at an
# external database instead — which is what Kubernetes does, where the whole
# DSN arrives as one secret key.
# DATABASE_URL=postgres://goforth:goforth_dev_password@localhost:5434/go_forth

# ---- Client runtime config --------------------------------------------------
# The client reads these from `window.env`, which is /env.js: served from
# client/public/ in dev, and rewritten from the container's environment at
# startup in Docker (client/docker-entrypoint.d/40-env-js.sh). That indirection
# is what lets one built image run in local, staging and production.
# Blank GAME_WS_BASE_URL means the client derives ws:// from the API base URL.
GAME_WS_BASE_URL=
# Where a "Play Go Forth! on JoinQuest" link sends a visitor. Blank falls back
# to the game's page on joinquest.cc.
GAME_LOBBY_URL=

# ---- Standalone mode (no Lobby) ---------------------------------------------
# `./scripts/stub-lobby.sh serve` stands in for JoinQuest: a real RS256 JWKS at
# /.well-known/jwks.json plus a seat-token minter, so the game is playable with
# no platform in front of it. 4002 pairs with the API's 3002.
STUB_LOBBY_PORT=4002
# Seat JWT `aud`: what a token must be addressed to for this API to accept it.
# Comma-separated. Blank disables the audience check, which is the local-dev
# default — the stub Lobby mints `aud` from whatever port it was told about, and
# a developer who has not set this should not be debugging an audience mismatch
# before the game has ever run. **Every deployed environment sets it.**
# GAME_API_AUDIENCE=http://localhost:3002

# Where the stub's `provision` sends the player back to, and where it pretends
# the Lobby's GraphQL lives. The stub does not implement GraphQL, so the result
# report fails — visibly and harmlessly, which is correct for a best-effort
# callback with no Lobby behind it.
# STUB_LOBBY_RETURN_URL=http://localhost:4002/return
# STUB_LOBBY_GRAPHQL_URL=http://localhost:4002/graphql
# Which mode the stub provisions. `opening-round` is the one-round demo;
# `starter` is the real first-to-three match.
# STUB_LOBBY_GAME_MODE=opening-round
# The bearer the stub sends and the API requires on that push.
# LOBBY_SERVICE_TOKEN=stub-service-token

# ---- Session layer (JQ-309) -------------------------------------------------
# Run with no database at all: live match state is in memory anyway, and this
# drops the persistence half so a fresh checkout is playable with nothing
# installed but Python. Also what lets the contract suite run in CI, which has
# no Postgres service.
# GAME_IN_MEMORY=1

# Require a Lobby seat token to claim a seat. Off by default, which is
# standalone mode: the game is playable with no platform in front of it, the
# first thing anyone reading a reference implementation tries. On in any
# environment the Lobby actually provisions.
# GAME_REQUIRE_LOBBY_AUTH=1

# `Secure` on the seat-binding cookie that carries recovery path 1. Defaults on
# anywhere GAME_APP_ENV is not `local`. Leave it off over plain-HTTP localhost
# or the browser discards the cookie and recovery silently never works.
# GAME_COOKIE_SECURE=1

# Lobby user ids this game refuses to host: provision answers 403 with the ids,
# and the Lobby re-matchmakes without them. Comma-separated. The integration
# checklist's `provision.banlist` row wants a 403 for its own test user, so this
# is a thing a dashboard run can set and unset without a migration.
# GAME_BANNED_LOBBY_USER_IDS=a0000000-0000-4000-8000-000000000099
