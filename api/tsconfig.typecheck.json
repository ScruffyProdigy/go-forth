{
  // Type-checks the tests as well as the sources.
  //
  // `tsconfig.json` excludes the tests because they are not compiled into `dist`,
  // and excluding them from the build would otherwise exclude them from the only
  // type check there is — a test can then assert something the compiler never
  // reads. This config is what CI's `npm run typecheck` step runs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
